APP_NAME=Countdownly
APP_ENV=local
APP_KEY=base64:RhVk5hgNsvm6FASVvp3C0wBvaFUqcHLUiVIKm+Ilv3s=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timergif
DB_USERNAME=root
DB_PASSWORD=12345678

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before DB queue re-releases a reserved job; must be > GIF job timeout (120).
DB_QUEUE_RETRY_AFTER=210

# GIF generation strategy:
# - "sync": generate GIF during the request (slow saves, no queue required)
# - "queue": dispatch job and generate via queue worker/cron (fast saves)
GIF_GENERATION_MODE=queue

# If show_final_message is enabled and the countdown duration is <= this number of seconds,
# pad the GIF by repeating the final screen so total length reaches this number.
FINAL_MESSAGE_TOTAL_SECONDS=60

# Max animation length (seconds / frames at 1fps) for generated GIFs.
GIF_FRAME_LIMIT_MAX_SECONDS=60

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
