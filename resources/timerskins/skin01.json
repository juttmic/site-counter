{
    "name": "Minimal Black Countdown",
    "width": 980,
    "height": 274,
    "background": "#FFFFFF",
    "textColor": "#000000",
    "separatorColor": "#000000",
    "fontSize": 95,
    "fontPath": "resources/fonts/dejavu-sans.book.ttf",
    "style": "minimal_black_countdown",
    "showDays": true,
    "showHours": true,
    "showMinutes": true,
    "showSeconds": true,
    "separator": ":",
    "layout": "horizontal",
    "animation": "none",
    "finalMessage": "Time's Up",
    "finalBackground": null,
    "finalTextColor": null,
    "borderWidth": 0,
    "borderColor": "#FFFFFF",

    "visibilityLayouts": {
      "allVisible": {
        "width": 400,
        "height": 160,
        "visibleUnits": 4,
        "note": "All 4 units visible"
      },
      "daysHidden": {
        "width": 300,
        "height": 160,
        "visibleUnits": 3,
        "note": "Hours, Minutes, Seconds only"
      },
      "secondsHidden": {
        "width": 300,
        "height": 160,
        "visibleUnits": 3,
        "note": "Days, Hours, Minutes only"
      },
      "daysAndSecondsHidden": {
        "width": 240,
        "height": 160,
        "visibleUnits": 2,
        "note": "Hours and Minutes only"
      }
    },

    "visibilityRules": {
      "keepSameCanvasIfOnlyOneEdgeUnitHidden": false,
      "useCompactCanvasIfDaysAndSecondsHidden": true,
      "compactTrigger": {
        "showDays": false,
        "showSeconds": false
      }
    },

    "formDefaults": {
        "background": "#D6D6D6",
        "textColor": "#000000"
    },
    "fields": [
        {
            "key": "width",
            "label": "Width",
            "type": "number",
            "min": 100,
            "max": 2000,
            "step": 10,
            "group": "Dimensions",
            "order": 4,
            "groupOrder": 1
        },
        {
            "key": "height",
            "label": "Height",
            "type": "number",
            "min": 10,
            "max": 1000,
            "step": 5,
            "group": "Dimensions",
            "order": 5
        },
        {
            "key": "background",
            "label": "Background",
            "type": "color",
            "group": "Appearance",
            "groupOrder": 1,
            "order": 7
        },
        {
            "key": "borderWidth",
            "label": "Border Width",
            "type": "number",
            "min": 0,
            "max": 50,
            "step": 1,
            "group": "Appearance",
            "order": 8
        },
        {
            "key": "borderColor",
            "label": "Border Color",
            "type": "color",
            "group": "Appearance",
            "order": 9
        },
        
        {
            "key": "separatorColor",
            "label": "Separator Color",
            "type": "color",
            "group": "Appearance",
            "groupOrder": 10
        },
        {
            "key": "textColor",
            "label": "Text Color",
            "type": "color",
            "group": "Appearance",
            "groupOrder": 4,
            "order": 11
        },
        {
            "key": "fontSize",
            "label": "Font Size",
            "type": "number",
            "min": 8,
            "max": 200,
            "step": 1,
            "group": "Appearance",
            "order": 12
        },
        {
            "key": "fontPath",
            "label": "Font",
            "type": "font",
            "group": "Appearance"
        },
        {
            "key": "showDays",
            "label": "Show Days",
            "type": "boolean",
            "groupOrder": 5,
            "group": "Visibility"
        },
        {
            "key": "showSeconds",
            "label": "Show Seconds",
            "type": "boolean",
            "group": "Visibility"
        },
        {
            "key": "separator",
            "label": "Separator",
            "type": "text",
            "maxLength": 5,
            "group": "Appearance",
            "order": 13
        },
        {
            "key": "finalMessage",
            "label": "Final Message",
            "type": "text",
            "maxLength": 64,
            "group": "Final Screen",
            "groupOrder": 6
        },
        {
            "key": "finalBackground",
            "label": "Final Background",
            "type": "color",
            "group": "Final Screen"
        },
        {
            "key": "finalTextColor",
            "label": "Final Text Color",
            "type": "color",
            "group": "Final Screen"
        }
        
    ]
}
