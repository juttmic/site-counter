{
    "name": "Minimal Black Countdown",
    "width": 400,
    "height": 160,
    "background": "#FFFFFF",
    "textColor": "#000000",
    "separatorColor": "#000000",
    "fontSize": 30,
    "fontPath": "resources/fonts/dejavu-sans.book.ttf",
    "style": "minimal_black_countdown",
    "showDays": true,
    "showHours": true,
    "showMinutes": true,
    "showSeconds": true,
    "separator": ":",
    "layout": "horizontal",
    "animation": "none",
    "finalMessage": "Time's Up",
    "finalBackground": null,
    "finalTextColor": null,
    "borderWidth": 0,
    "borderColor": "#FFFFFF",
    "formDefaults": {
        "background": "#FFFFFF",
        "textColor": "#DB0000"
    },
    "fields": [
        {
            "key": "width",
            "label": "Width",
            "type": "number",
            "min": 100,
            "max": 2000,
            "step": 10,
            "group": "Dimensions",
            "order": 4,
            "groupOrder": 1
        },
        {
            "key": "height",
            "label": "Height",
            "type": "number",
            "min": 10,
            "max": 1000,
            "step": 5,
            "group": "Dimensions",
            "order": 5
        },
        {
            "key": "background",
            "label": "Background Color",
            "type": "color",
            "group": "GIF Appearance",
            "groupOrder": 2,
            "order": 1
        },
        {
            "key": "borderWidth",
            "label": "Border Width",
            "type": "number",
            "min": 0,
            "max": 50,
            "step": 1,
            "group": "GIF Appearance",
            "order": 2
        },
        {
            "key": "borderColor",
            "label": "Border Color",
            "type": "color",
            "group": "GIF Appearance",
            "order": 3
        },
        
        {
            "key": "separatorColor",
            "label": "Separator Color",
            "type": "color",
            "group": "Separator & Box",
            "groupOrder": 3
        },
        {
            "key": "textColor",
            "label": "Text Color",
            "type": "color",
            "group": "Digits",
            "groupOrder": 4,
            "order": 1
        },
        {
            "key": "fontSize",
            "label": "Font Size",
            "type": "number",
            "min": 8,
            "max": 200,
            "step": 1,
            "group": "Digits",
            "order": 2
        },
        {
            "key": "fontPath",
            "label": "Font",
            "type": "font",
            "group": "GIF Appearance"
        },
        {
            "key": "showDays",
            "label": "Show Days",
            "type": "boolean",
            "groupOrder": 5,
            "group": "Visibility"
        },
        {
            "key": "showHours",
            "label": "Show Hours",
            "type": "boolean",
            "group": "Visibility"
        },
        {
            "key": "showMinutes",
            "label": "Show Minutes",
            "type": "boolean",
            "group": "Visibility"
        },
        {
            "key": "showSeconds",
            "label": "Show Seconds",
            "type": "boolean",
            "group": "Visibility"
        },
        {
            "key": "separator",
            "label": "Separator",
            "type": "text",
            "maxLength": 5,
            "group": "Separator & Box",
            "order": 1
        },
        {
            "key": "finalMessage",
            "label": "Final Message",
            "type": "text",
            "maxLength": 64,
            "group": "Final Screen",
            "groupOrder": 6
        },
        {
            "key": "finalBackground",
            "label": "Final Background",
            "type": "color",
            "group": "Final Screen"
        },
        {
            "key": "finalTextColor",
            "label": "Final Text Color",
            "type": "color",
            "group": "Final Screen"
        }
        
    ]
}
