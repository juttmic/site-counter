{
  "name": "Hex Tile Labels",
  "width": 760,
  "height": 180,
  "background": "#FFFFFF",
  "textColor": "#FFFFFF",
  "accentColor": "#3B8C8F",
  "fontSize": 28,
  "fontPath": "resources/fonts/dejavu-sans.bold.ttf",
  "style": "hex_tile",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",
  "formDefaults": {
        "background": "#FFFFFF",
        "textColor": "#FFFFFF",
        "accentColor": "#DB0000"
    },
  "fields": [
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10, "group": "Dimensions", "groupOrder": 1, "order": 2 },
    { "key": "height", "label": "Height", "type": "number", "min": 80, "max": 1000, "step": 5, "group": "Dimensions", "order": 3 },
    { "key": "background", "label": "Background Color", "type": "color", "group": "GIF Appearance", "groupOrder": 2, "order": 1 },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1, "group": "GIF Appearance", "order": 4 },
    { "key": "borderColor", "label": "Border Color", "type": "color", "group": "GIF Appearance", "order": 5 },
    { "key": "textColor", "label": "Text Color", "type": "color", "group": "Digits", "groupOrder": 3, "order": 1 },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1, "group": "Digits", "order": 2 },
    { "key": "showDays", "label": "Show Days", "type": "boolean", "group": "Visibility", "groupOrder": 4, "order": 3 },
    { "key": "showHours", "label": "Show Hours", "type": "boolean", "group": "Visibility", "order": 4 },
    { "key": "showMinutes", "label": "Show Minutes", "type": "boolean", "group": "Visibility", "order": 5 },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean", "group": "Visibility", "order": 6 },
    { "key": "accentColor", "label": "Tile Color", "type": "color", "group": "Separator & Box", "groupOrder": 5 },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64, "group": "Final Screen", "groupOrder": 6 },
    { "key": "finalBackground", "label": "Final Background", "type": "color", "group": "Final Screen"  },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color", "group": "Final Screen" }
  ]
}


