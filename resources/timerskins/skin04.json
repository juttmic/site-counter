{
  "name": "Inverted Pill Labels",
  "width": 560,
  "height": 160,
  "background": "#FFFFFF",
  "textColor": "#FFFFFF",
  "separatorColor": "#FFFFFF",
  "accentColor": "#FF3B30",
  "fontSize": 44,
  "fontPath": "resources/fonts/dejavu-sans.book.ttf",
  "style": "inverted_pill_labels",
  "tileColor": "#000000",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "separator": ":",
  "layout": "horizontal",
  "animation": "none",
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",
  "fields": [
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10 },
    { "key": "height", "label": "Height", "type": "number", "min": 50, "max": 1000, "step": 5 },
    { "key": "background", "label": "Background Color", "type": "color" },
    { "key": "textColor", "label": "Digit Color", "type": "color" },
    { "key": "separatorColor", "label": "Separator Color", "type": "color" },
    { "key": "accentColor", "label": "Label Color", "type": "color" },
    { "key": "tileColor", "label": "Tile Color", "type": "color" },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1 },
    { "key": "fontPath", "label": "Font", "type": "font" },
    { "key": "showDays", "label": "Show Days", "type": "boolean" },
    { "key": "showHours", "label": "Show Hours", "type": "boolean" },
    { "key": "showMinutes", "label": "Show Minutes", "type": "boolean" },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean" },
    { "key": "separator", "label": "Separator", "type": "text", "maxLength": 5 },
    { "key": "layout", "label": "Layout", "type": "select", "options": ["horizontal", "vertical"] },
    { "key": "animation", "label": "Animation", "type": "select", "options": ["none", "fade", "slide"] },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64 },
    { "key": "finalBackground", "label": "Final Background", "type": "color" },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color" },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1 },
    { "key": "borderColor", "label": "Border Color", "type": "color" }
  ]
}
