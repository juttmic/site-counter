{
  "name": "Dark Slate Timer",
  "width": 460,
  "height": 180,
  "background": "#0f172a",
  "textColor": "#e2e8f0",
  "accentColor": "#22d3ee",
  "fontSize": 20,
  "fontPath": "resources/fonts/dejavu-sans.book.ttf",
  "style": "dark_neon_outline",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "separator": ":",
  "layout": "horizontal",
  "animation": "none",
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",
  "formDefaults": {
        "background": "#FFFFFF",
        "textColor": "#DB0000",
        "accentColor": "#DB0000"
    },
  "fields": [
    { "key": "background", "label": "Background Color", "type": "color", "group": "GIF Appearance", "groupOrder": 1, "order": 1 },
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10, "group": "GIF Appearance", "groupOrder": 1, "order": 2 },
    { "key": "height", "label": "Height", "type": "number", "min": 50, "max": 1000, "step": 5, "group": "GIF Appearance", "groupOrder": 1, "order": 3 },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1, "group": "GIF Appearance", "groupOrder": 1, "order": 4 },
    { "key": "borderColor", "label": "Border Color", "type": "color", "group": "GIF Appearance", "groupOrder": 1, "order": 5 },
    { "key": "textColor", "label": "Text Color", "type": "color", "group": "Counter.Digits", "groupOrder": 2, "order": 1 },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1, "group": "Counter.Digits", "groupOrder": 2, "order": 2 },
    { "key": "showDays", "label": "Show Days", "type": "boolean", "group": "Counter.Digits", "groupOrder": 2, "order": 3 },
    { "key": "showHours", "label": "Show Hours", "type": "boolean", "group": "Counter.Digits", "groupOrder": 2, "order": 4 },
    { "key": "showMinutes", "label": "Show Minutes", "type": "boolean", "group": "Counter.Digits", "groupOrder": 2, "order": 5 },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean", "group": "Counter.Digits", "groupOrder": 2, "order": 6 },
    { "key": "layout", "label": "Layout", "type": "select", "options": ["horizontal", "vertical"], "group": "Counter.Digits", "groupOrder": 2, "order": 7 },
    { "key": "animation", "label": "Animation", "type": "select", "options": ["none", "fade", "slide"], "group": "Counter.Digits", "groupOrder": 2, "order": 8 },
    { "key": "accentColor", "label": "Box Border Color", "type": "color", "group": "Counter.Separator & Box", "groupOrder": 3, "order": 1 },
    { "key": "separator", "label": "Separator", "type": "text", "maxLength": 5, "group": "Counter.Separator & Box", "groupOrder": 3, "order": 2 },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64, "group": "Final Screen", "groupOrder": 4 },
    { "key": "finalBackground", "label": "Final Background", "type": "color", "group": "Final Screen", "groupOrder": 4 },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color", "group": "Final Screen", "groupOrder": 4 }
  ]
}
