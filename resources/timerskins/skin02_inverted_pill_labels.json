{
  "name": "Inverted Pill Labels",
  "width": 560,
  "height": 160,
  "background": "#FFFFFF",
  "textColor": "#FFFFFF",
  "separatorColor": "#FFFFFF",
  "accentColor": "#FF3B30",
  "fontSize": 25,
  "fontPath": "resources/fonts/dejavu-sans.book.ttf",
  "style": "inverted_pill_labels",
  "tileColor": "#000000",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "separator": ":",
  "layout": "horizontal",
  "animation": "none",
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",

  "visibilityLayouts": {
    "allVisible": {
      "width": 560,
      "height": 160,
      "visibleUnits": 4,
      "note": "All 4 units visible"
    },
    "daysHidden": {
      "width": 420,
      "height": 160,
      "visibleUnits": 3,
      "note": "Hours, Minutes, Seconds only"
    },
    "secondsHidden": {
      "width": 420,
      "height": 160,
      "visibleUnits": 3,
      "note": "Days, Hours, Minutes only"
    },
    "daysAndSecondsHidden": {
      "width": 280,
      "height": 160,
      "visibleUnits": 2,
      "note": "Hours and Minutes only"
    }
  },

  "visibilityRules": {
    "keepSameCanvasIfOnlyOneEdgeUnitHidden": false,
    "useCompactCanvasIfDaysAndSecondsHidden": true,
    "compactTrigger": {
      "showDays": false,
      "showSeconds": false
    }
  },

  "formDefaults": {
        "background": "#FFFFFF",
        "textColor": "#FFFFFF",
        "tileColor": "#DB0000"
    },
  "fields": [
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10, "group": "Dimensions", "groupOrder": 2, "order": 2 },
    { "key": "height", "label": "Height", "type": "number", "min": 50, "max": 1000, "step": 5, "group": "Dimensions", "order": 3 },
    { "key": "background", "label": "Background", "type": "color", "group": "Appearance", "groupOrder": 1, "order": 1 },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1, "group": "Appearance", "order": 2 },
    { "key": "borderColor", "label": "Border Color", "type": "color", "group": "Appearance", "order": 3 },
    { "key": "textColor", "label": "Digit Color", "type": "color", "group": "Appearance", "groupOrder": 3, "order": 4 },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1, "group": "Appearance", "order": 5 },
    { "key": "layout", "label": "Layout", "type": "select", "options": ["horizontal", "vertical"], "group": "Appearance", "order": 6 },
    { "key": "animation", "label": "Animation", "type": "select", "options": ["none", "fade", "slide"], "group": "Appearance", "order": 7 },
    { "key": "showDays", "label": "Show Days", "type": "boolean", "group": "Visibility", "groupOrder": 4, "order": 3 },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean", "group": "Visibility", "order": 4 },
    { "key": "separatorColor", "label": "Separator Color", "type": "color", "group": "Appearance", "groupOrder": 5, "order": 8 },
    { "key": "separator", "label": "Separator", "type": "text", "maxLength": 5, "group": "Appearance", "order": 9 },
    { "key": "accentColor", "label": "Label Color", "type": "color", "group": "Appearance", "order": 10 },
    { "key": "tileColor", "label": "Tile Color", "type": "color", "group": "Appearance", "order": 11 },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64, "group": "Final Screen", "groupOrder": 6 },
    { "key": "finalBackground", "label": "Final Background", "type": "color", "group": "Final Screen"  },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color", "group": "Final Screen" }
  ]
}
