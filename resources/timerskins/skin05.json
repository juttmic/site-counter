{
  "name": "Slate Blue Timer",
  "width": 500,
  "height": 200,
  "background": "#F2F5F8",
  "textColor": "#FFFFFF",
  "accentColor": "#2C7A8B",
  "fontSize": 25,
  "fontPath": "resources/fonts/dejavu-sans.book.ttf",
  "style": "slate_rounded_bar",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "layout": "horizontal",
  "animation": "none",
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",
  "formDefaults": {
        "background": "#FFFFFF",
        "textColor": "#FFFFFF",
        "accentColor": "#DB0000"
    },
  "fields": [
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10, "group": "Dimensions", "groupOrder": 2, "order": 2 },
    { "key": "height", "label": "Height", "type": "number", "min": 50, "max": 1000, "step": 5, "group": "Dimensions", "order": 3 },
    { "key": "background", "label": "Background Color", "type": "color", "group": "Appearance", "groupOrder": 1, "order": 1 },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1, "group": "Appearance", "order": 4 },
    { "key": "borderColor", "label": "Border Color", "type": "color", "group": "Appearance", "order": 5 },
    { "key": "textColor", "label": "Text Color", "type": "color", "group": "Appearance", "groupOrder": 3, "order": 1 },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1, "group": "Appearance", "order": 2 },
    { "key": "layout", "label": "Layout", "type": "select", "options": ["horizontal", "vertical"], "group": "Appearance", "order": 3 },
    { "key": "animation", "label": "Animation", "type": "select", "options": ["none", "fade", "slide"], "group": "Appearance", "order": 4 },
    { "key": "showDays", "label": "Show Days", "type": "boolean", "group": "Visibility", "groupOrder": 4, "order": 3 },
    { "key": "showHours", "label": "Show Hours", "type": "boolean", "group": "Visibility", "order": 4 },
    { "key": "showMinutes", "label": "Show Minutes", "type": "boolean", "group": "Visibility", "order": 5 },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean", "group": "Visibility", "order": 6 },
    { "key": "accentColor", "label": "Bar Color", "type": "color", "group": "Appearance", "groupOrder": 5 },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64, "group": "Final Screen", "groupOrder": 6 },
    { "key": "finalBackground", "label": "Final Background", "type": "color", "group": "Final Screen"  },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color", "group": "Final Screen" }
  ]
}
