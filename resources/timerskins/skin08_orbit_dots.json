{
  "name": "Orbit Dots",
  "width": 760,
  "height": 200,
  "background": "#D6D6D6",
  "textColor": "#111111",
  "accentColor": "#22A699",
  "fontSize": 45,
  "fontPath": "resources/fonts/dejavu-sans.book.ttf",
  "style": "orbit_dots",
  "showDays": true,
  "showHours": true,
  "showMinutes": true,
  "showSeconds": true,
  "finalMessage": "Time's Up",
  "finalBackground": null,
  "finalTextColor": null,
  "borderWidth": 0,
  "borderColor": "#FFFFFF",

  "visibilityLayouts": {
    "allVisible": {
      "width": 760,
      "height": 200,
      "visibleUnits": 4,
      "note": "All 4 units visible"
    },
    "daysHidden": {
      "width": 570,
      "height": 200,
      "visibleUnits": 3,
      "note": "Hours, Minutes, Seconds only"
    },
    "secondsHidden": {
      "width": 570,
      "height": 200,
      "visibleUnits": 3,
      "note": "Days, Hours, Minutes only"
    },
    "daysAndSecondsHidden": {
      "width": 380,
      "height": 200,
      "visibleUnits": 2,
      "note": "Hours and Minutes only"
    }
  },

  "visibilityRules": {
    "keepSameCanvasIfOnlyOneEdgeUnitHidden": false,
    "useCompactCanvasIfDaysAndSecondsHidden": true,
    "compactTrigger": {
      "showDays": false,
      "showSeconds": false
    }
  },

  "formDefaults": {
        "background": "#D6D6D6",
        "textColor": "#000000",
        "accentColor": "#000000"
    },
  "fields": [
    { "key": "width", "label": "Width", "type": "number", "min": 100, "max": 2000, "step": 10, "group": "Dimensions", "groupOrder": 2, "order": 2 },
    { "key": "height", "label": "Height", "type": "number", "min": 80, "max": 1000, "step": 5, "group": "Dimensions", "order": 3 },
    { "key": "background", "label": "Background", "type": "color", "group": "Appearance", "groupOrder": 1, "order": 1 },
    { "key": "borderWidth", "label": "Border Width", "type": "number", "min": 0, "max": 50, "step": 1, "group": "Appearance", "order": 2 },
    { "key": "borderColor", "label": "Border Color", "type": "color", "group": "Appearance", "order": 3 },
    { "key": "textColor", "label": "Text Color", "type": "color", "group": "Appearance", "groupOrder": 3, "order": 4 },
    { "key": "fontSize", "label": "Font Size", "type": "number", "min": 8, "max": 200, "step": 1, "group": "Appearance", "order": 5 },
    { "key": "showDays", "label": "Show Days", "type": "boolean", "group": "Visibility", "groupOrder": 4, "order": 3 },
    { "key": "showSeconds", "label": "Show Seconds", "type": "boolean", "group": "Visibility", "order": 4 },
    { "key": "accentColor", "label": "Dot Color", "type": "color", "group": "Appearance", "groupOrder": 5, "order":6 },
    { "key": "finalMessage", "label": "Final Message", "type": "text", "maxLength": 64, "group": "Final Screen", "groupOrder": 6 },
    { "key": "finalBackground", "label": "Final Background", "type": "color", "group": "Final Screen"  },
    { "key": "finalTextColor", "label": "Final Text Color", "type": "color", "group": "Final Screen" }
  ]
}


